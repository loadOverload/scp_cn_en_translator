# =============================================================================
# 大型数据与生成物 —— 不进版本库
#
# 这些都能由 scripts/ 下的流程重新生成，且体积远超 GitHub 的合理范围。
# 语料还涉及版权：SCP 中英文内容遵循 CC BY-SA 3.0，
# 应由爬取脚本获取，而不是随仓库分发。
#
# 注意：.gitignore 不支持行尾注释，注释必须独占一行，
# 否则整行（含 # 之后的内容）都会被当作匹配模式。
# =============================================================================

# 语料与派生数据
data/raw/
data/aligned/
data/conversion/
data/conversion_8k/
data/samples/
data/tokenized_cache/
data/hf_cache/
data/embeddings/

# 兜底：data 下任何未显式列出的子目录
data/*/

# 本地模型权重（bge-m3，2.2 GB）
models/

# 训练产物
outputs/*
outputs/*.pid
outputs/*.log

# 保留这几份体积小、用于核对发布数据的文件
!outputs/eval_final_metrics.json
!outputs/eval_adapters.json
!outputs/eval_generations.jsonl

# 发布用的 LoRA 适配器（77 MiB）—— 逐层放行。
# git 无法在被整体忽略的目录内部重新包含文件，必须从最外层一层层写进来。
!outputs/qwen2.5-7b-scp-convert-stage3-8k/
outputs/qwen2.5-7b-scp-convert-stage3-8k/*
!outputs/qwen2.5-7b-scp-convert-stage3-8k/final_adapter/

# 权重只在 GitHub Release 提供，不进 git。
# 77 MiB 的二进制留在历史里会让每次 clone 都多下 77 MiB，
# 而且以后每更新一版权重就再叠一份。
outputs/qwen2.5-7b-scp-convert-stage3-8k/final_adapter/adapter_model.safetensors

# =============================================================================
# 日志
# =============================================================================
logs/
*.log

# =============================================================================
# Python
# =============================================================================
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
build/
dist/
*.egg-info/
.eggs/

# 虚拟环境
.venv/
venv/
env/
ENV/

# =============================================================================
# 训练与推理的临时文件
# =============================================================================
*.tmp
*.temp
*.part
*.incomplete
checkpoint-*/
runs/
events.out.tfevents.*

# =============================================================================
# 编辑器 / 系统
# =============================================================================
.vscode/
.idea/
*.swp
*.swo
.DS_Store
Thumbs.db

# =============================================================================
# 本地配置与凭据（防止误提交 API key）
# =============================================================================
.env
.env.*
*.secret
*_key.txt
configs/local*.yaml
